// #Arduino sketch

#include <Arduino.h>

const int ONBOARD_LED_PIN = 0; // Onboard Blue LED

// Joystick pins on Milk-V Duo S Header J3
const int PIN_UP    = 3;  // 1 blink
const int PIN_DOWN  = 5;  // 2 blinks
const int PIN_LEFT  = 7;  // 3 blinks
const int PIN_RIGHT = 11; // 4 blinks

void blinkCount(int times) {
  for (int i = 0; i < times; i++) {
    digitalWrite(ONBOARD_LED_PIN, HIGH);
    delay(150);
    digitalWrite(ONBOARD_LED_PIN, LOW);
    delay(150);
  }
  delay(600);
}

void setup() {
  pinMode(ONBOARD_LED_PIN, OUTPUT);

  // 3 quick flashes confirm the new sketch actually booted
  for (int i = 0; i < 3; i++) {
    digitalWrite(ONBOARD_LED_PIN, HIGH);
    delay(80);
    digitalWrite(ONBOARD_LED_PIN, LOW);
    delay(80);
  }

  pinMode(PIN_UP, INPUT_PULLUP);
  pinMode(PIN_DOWN, INPUT_PULLUP);
  pinMode(PIN_LEFT, INPUT_PULLUP);
  pinMode(PIN_RIGHT, INPUT_PULLUP);
}

void loop() {
  if (digitalRead(PIN_UP) == LOW) {
    blinkCount(1);
  } else if (digitalRead(PIN_DOWN) == LOW) {
    blinkCount(2);
  } else if (digitalRead(PIN_LEFT) == LOW) {
    blinkCount(3);
  } else if (digitalRead(PIN_RIGHT) == LOW) {
    blinkCount(4);
  } else {
    digitalWrite(ONBOARD_LED_PIN, LOW);
    delay(10);
  }
}
